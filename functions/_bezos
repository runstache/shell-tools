#compdef bezos

_bezos() {
    _arguments -C \
        '1:action:(login creds bastion list)' \
        '2:cluster:_bezos_bastion' 
   
}

_bezos_bastion(){
  local bastionfile="${HOME}/bastion.json"
  local -a clusters
     
  clusters=("${(@f)$(jq -r 'keys[]' "$bastionfile" 2>/dev/null)}")
  compadd -- "${clusters[@]}"
}

_bezos "$@"